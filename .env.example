# Copy to server/.env and fill in. Never commit the real file.
# Every variable here is validated with zod at boot: the process refuses to start on a
# missing or short secret, which turns "works locally, 500s in production" into a loud failure.

NODE_ENV=development
PORT=5000

# MongoDB Atlas M0 connection string
MONGODB_URI=mongodb://localhost:27017/r4u

# minimum 32 characters each, and different from one another
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# comma separated, exact origins. never a wildcard with credentials
CORS_ORIGINS=http://localhost:5173

# set true only in a preview environment, never in production
ALLOW_PREVIEW_ORIGINS=false

# avatars and template thumbnails. free tier is 25 monthly credits
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# password reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=R4U <no-reply@r4u.local>
# Brevo transactional API key. Used instead of SMTP when set; needed on Render, which blocks SMTP ports
BREVO_API_KEY=

# public base used to build share links
APP_URL=http://localhost:5173

LOG_LEVEL=debug
